# This is a template for the kfet/homebrew-ai tap.
#
# Formula/fir.rb in the tap is regenerated automatically by GoReleaser on
# every kfet/fir tag push (see the brews: block in .goreleaser.yaml).
# This file is kept in the main repo purely as a reference — it is NOT
# the file Homebrew reads, and edits here do not affect users.
#
# Users install with:
#   brew install kfet/ai/fir
#   (or: brew tap kfet/ai && brew install fir)
#
# Download URLs point at the public kfet/fir-dist mirror so installation
# works without GitHub authentication.

class Fir < Formula
  desc "Fast, portable AI coding agent"
  homepage "https://github.com/kfet/fir"
  license "MIT"

  # GoReleaser replaces url, sha256, and version on each release.
  url "https://github.com/kfet/fir-dist/releases/download/v0.4.0/fir-#{OS}-#{ARCH}"
  version "0.4.0"
  sha256 "PLACEHOLDER"

  def install
    bin.install Dir["fir-*"].first => "fir"
    generate_completions_from_executable(bin/"fir", "completion")
  end

  # Mirrors the caveats: block in .goreleaser.yaml. GoReleaser wraps that block
  # in `<<~EOS ... EOS`, so the whole body is one Ruby interpolation returning
  # either the warning or nil — a clean install yields a blank string, which
  # Homebrew suppresses.
  def caveats
    <<~EOS
      #{
        begin
          linked = "#{HOMEBREW_PREFIX}/bin/fir"
          ours = File.exist?(linked) ? File.realpath(linked) : nil
          brewed = [HOMEBREW_PREFIX.to_s, HOMEBREW_CELLAR.to_s]
          others = ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).reject(&:empty?).uniq.filter_map do |dir|
            candidate = File.join(dir, "fir")
            next unless File.file?(candidate) && File.executable?(candidate)
            real = File.realpath(candidate)
            next if real == ours || brewed.any? { |prefix| real.start_with?(prefix) }
            real
          end.uniq
          if others.empty?
            nil
          else
            # One thread per candidate: probing N binaries costs one probe's
            # wall time, not N. FIR_NO_UPDATE_CHECK stops fir >= 1.3 phoning
            # home; older copies ignore it but now stall concurrently.
            listed = others.map do |path|
              Thread.new do
                found = Utils.popen_read({ "FIR_NO_UPDATE_CHECK" => "1" }, path, "--version").lines.first.to_s.strip
                found = "unknown version" if found.empty?
                "  #{path} (#{found})"
              end
            end.map(&:value)
            "Another fir is on your PATH and may shadow this one:\n" +
              listed.join("\n") + "\n  #{linked} (#{version}) <- installed here\n\n" +
              "PATH order decides which one runs, and each updates separately. Remove the\n" +
              "other copy, or put #{HOMEBREW_PREFIX}/bin first on PATH."
          end
        rescue StandardError
          nil
        end
      }
    EOS
  end

  test do
    system bin/"fir", "--version"
  end
end


