# This is a template for the kfet/homebrew-ai tap.
#
# Formula/fir.rb in the tap is regenerated automatically by GoReleaser on
# every kfet/fir tag push (see the brews: block in .goreleaser.yaml).
# This file is kept in the main repo purely as a reference — it is NOT
# the file Homebrew reads, and edits here do not affect users.
#
# Users install with:
#   brew install kfet/ai/fir
#   (or: brew tap kfet/ai && brew install fir)
#
# Download URLs point at the public kfet/fir-dist mirror so installation
# works without GitHub authentication.

class Fir < Formula
  desc "Fast, portable AI coding agent"
  homepage "https://github.com/kfet/fir"
  license "MIT"

  # GoReleaser replaces url, sha256, and version on each release.
  url "https://github.com/kfet/fir-dist/releases/download/v0.4.0/fir-#{OS}-#{ARCH}"
  version "0.4.0"
  sha256 "PLACEHOLDER"

  def install
    bin.install Dir["fir-*"].first => "fir"
    generate_completions_from_executable(bin/"fir", "completion")
  end

  test do
    system bin/"fir", "--version"
  end
end


